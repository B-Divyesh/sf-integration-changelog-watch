{
  "name": "integration-changelog-watch",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:browser": "playwright test",
    "test:a11y": "playwright test tests/browser/accessibility.spec.ts",
    "test:container": "cargo build --release --locked",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.10.2",
    "playwright-core": "1.58.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
